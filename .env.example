# 텔레그램 BotFather에서 발급받은 봇 토큰
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 메시지를 받을 텔레그램 채팅 ID
# 확인 방법: @userinfobot 에서 자신의 ID 확인
CHAT_ID=your_chat_id_here

# 타임존 (기본값: Asia/Seoul)
TIMEZONE=Asia/Seoul

# [선택] 한국수출입은행 API 키 (없으면 Yahoo Finance 사용)
# 발급: https://www.koreaexim.go.kr/site/program/financial/exchangeJSON
EXIM_API_KEY=
